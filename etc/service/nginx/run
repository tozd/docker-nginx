#!/bin/bash -e

trap 'echo "ERROR: $BASH_SOURCE:$LINENO $BASH_COMMAND" >&2' ERR

# The client's address is taken from the X-Forwarded-For header by skipping trusted addresses
# from its right end, so addresses which the client itself put into the header are ignored.
if [ -n "$SET_REAL_IP_FROM" ]; then
  {
    IFS=',' read -r -a addresses <<< "$SET_REAL_IP_FROM"
    for address in "${addresses[@]}"; do
      address="${address//[[:space:]]/}"
      if [ -n "$address" ]; then
        echo "set_real_ip_from $address;"
      fi
    done
    echo "real_ip_header X-Forwarded-For;"
    echo "real_ip_recursive on;"
  } > /etc/nginx/conf.d/set_real_ip_from.conf
else
  rm -f /etc/nginx/conf.d/set_real_ip_from.conf
fi

if [ "${LOG_TO_STDOUT}" != "1" ]; then
  for file in /var/log/nginx/default_access.log /var/log/nginx/access.log /var/log/nginx/error.log ; do
    if [[ -L "$file" ]]; then
      rm -f "$file"
    fi
  done
else
  ln -sf /dev/stdout /var/log/nginx/default_access.log
  ln -sf /dev/stdout /var/log/nginx/access.log
  ln -sf /dev/stderr /var/log/nginx/error.log
fi

# Initialization hook.
[ -f /etc/service/nginx/run.initialization ] && source /etc/service/nginx/run.initialization

exec /usr/sbin/nginx
